# Di server produksi: NODE_ENV=production. APP_URL wajib https saat production.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://lydev:lydev@localhost:5432/lydev_pay

# Login operator tunggal. Buat hash dengan: npm run admin:hash
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_PASSWORD=

# Sumopod. Production memakai SUMOPOD_ENV=production dan base URL https://api-pay.sumopod.com/api/v1.
SUMOPOD_ENV=sandbox
SUMOPOD_API_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
# Host halaman checkout provider. Sandbox: pay-sandbox.sumopod.com. Production: checkout.pymnt.app.
SUMOPOD_ALLOWED_PAYMENT_HOSTS=pay-sandbox.sumopod.com,pay.sumopod.com,checkout.pymnt.app
# Header IP dari reverse proxy tepercaya untuk rate limit login (Cloudflare: cf-connecting-ip, nginx: x-real-ip).
TRUSTED_PROXY_HEADER=cf-connecting-ip
QR_BROWSER_ENABLED=true
QR_BROWSER_CHANNEL=chrome
# Pada container Linux, isi path Chromium jika Chrome channel tidak tersedia.
QR_BROWSER_EXECUTABLE_PATH=

API_KEY_PEPPER=
MAX_PAYMENT_AMOUNT=10000000
