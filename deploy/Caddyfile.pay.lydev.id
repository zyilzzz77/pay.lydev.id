# Tempelkan blok ini ke Caddyfile milik Caddy yang SUDAH berjalan
# (jangan jalankan Caddy kedua). Kalau setup Caddy Anda memakai folder conf.d,
# simpan saja file ini di sana dengan nama pay.lydev.id.caddyfile.
#
# Syarat:
# - container ini terhubung ke network Docker yang sama dengan Caddy
#   (lihat CADDY_NETWORK di docker-compose.prod.yml)
# - DNS pay.lydev.id sudah mengarah ke VPS ini, port 80/443 sampai ke Caddy
# - TRUSTED_PROXY_HEADER=x-real-ip di .env aplikasi

pay.lydev.id {
	encode zstd gzip

	reverse_proxy lydev-pay-app:3000 {
		# Ganti header dengan IP klien asli supaya tidak bisa dipalsukan
		# oleh header kiriman klien. Aplikasi membaca header ini.
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access-lydev.log
	}
}

# Kalau Cloudflare dipasang di depan Caddy, {remote_host} berisi IP Cloudflare.
# Pada kasus itu pakai blok berikut dan set TRUSTED_PROXY_HEADER=cf-connecting-ip:
#
# pay.lydev.id {
# 	encode zstd gzip
# 	reverse_proxy lydev-pay-app:3000 {
# 		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
# 	}
# }
