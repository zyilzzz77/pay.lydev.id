# Tempelkan blok ini ke Caddyfile milik Caddy yang SUDAH berjalan
# (jangan jalankan Caddy kedua). Kalau setup Caddy Anda memakai folder conf.d,
# simpan saja file ini di sana dengan nama pay.lydev.id.caddyfile.
#
# Syarat:
# - container ini terhubung ke network Docker yang sama dengan Caddy
#   (lihat CADDY_NETWORK di docker-compose.prod.yml)
# - DNS pay.lydev.id sudah mengarah ke VPS ini, port 80/443 sampai ke Caddy
# - TRUSTED_PROXY_HEADER=cf-connecting-ip di .env aplikasi (Cloudflare proxy ON)

pay.lydev.id {
	encode zstd gzip

	reverse_proxy lydev-pay-app:3000 {
		# Cloudflare ada di depan Caddy (proxy ON), jadi IP klien asli datang lewat
		# header CF-Connecting-IP yang diisi Cloudflare. JANGAN pakai {remote_host}:
		# di posisi ini nilainya IP edge Cloudflare, bukan IP pengunjung, sehingga
		# semua klien jatuh ke satu bucket rate limit dan login operator bisa dikunci.
		#
		# Aplikasi membaca header ini (TRUSTED_PROXY_HEADER=cf-connecting-ip).
		# Supaya tidak bisa dipalsukan lewat koneksi langsung ke origin, batasi akses
		# ke VPS hanya dari rentang IP Cloudflare (security group/firewall) atau
		# tambahkan `trusted_proxies` pada reverse_proxy ini.
	}

	log {
		output file /data/access-lydev.log
	}
}

# Kalau TIDAK memakai Cloudflare (klien terhubung langsung ke Caddy), ganti blok
# di atas dengan yang berikut dan set TRUSTED_PROXY_HEADER=x-real-ip di .env:
#
# pay.lydev.id {
# 	encode zstd gzip
# 	reverse_proxy lydev-pay-app:3000 {
# 		header_up X-Real-IP {remote_host}
# 	}
# }
