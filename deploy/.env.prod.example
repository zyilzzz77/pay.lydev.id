# Salin menjadi .env lalu isi nilainya. File ini dipakai dua hal:
# 1. interpolasi docker compose (POSTGRES_*, CADDY_NETWORK)
# 2. env_file untuk container app
# Jangan isi DATABASE_URL di sini; compose yang membuatnya ke service `postgres`.

POSTGRES_USER=lydev
POSTGRES_PASSWORD=ganti-dengan-password-panjang-dan-acak
POSTGRES_DB=lydev_pay
# Samakan dengan nama network Docker milik Caddy (lihat: docker network ls).
CADDY_NETWORK=caddy

APP_URL=https://pay.lydev.id
NODE_ENV=production

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_PASSWORD=
API_KEY_PEPPER=

SUMOPOD_ENV=production
SUMOPOD_API_BASE_URL=https://api-pay.sumopod.com/api/v1
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=whsec_
SUMOPOD_ALLOWED_PAYMENT_HOSTS=pay-sandbox.sumopod.com,pay.sumopod.com,checkout.pymnt.app

# IP klien untuk rate limit login. x-real-ip karena Caddy mengirim {remote_host}.
TRUSTED_PROXY_HEADER=x-real-ip
# Tidak ada Chrome di image runtime; QR diambil dari payload QRIS halaman provider.
QR_BROWSER_ENABLED=false
MIN_PAYMENT_AMOUNT=10000
MAX_PAYMENT_AMOUNT=10000000
